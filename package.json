{
  "name": "palermo-perfume-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "e2e:reset": "tsx tests/e2e/reset-db.ts",
    "e2e:migrate": "tsx tests/e2e/migrate.ts",
    "e2e:seed": "tsx tests/e2e/seed.ts",
    "e2e:clean": "node tests/e2e/clean-artifacts.mjs",
    "e2e:customer": "pnpm e2e:clean && playwright test tests/e2e/customer-critical-journey.spec.ts",
    "e2e:admin": "pnpm e2e:clean && playwright test tests/e2e/admin-critical-journey.spec.ts",
    "test:e2e": "pnpm db:generate && pnpm e2e:reset && pnpm e2e:migrate && pnpm e2e:seed && pnpm e2e:customer && pnpm e2e:admin",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx prisma/check.ts",
    "demo:reset": "node --conditions=react-server --import tsx prisma/reset-demo.ts",
    "demo:check": "tsx prisma/check-demo.ts",
    "catalogue:populate": "tsx prisma/populate-catalogue.ts",
    "auth:check": "node --conditions=react-server --import tsx src/modules/identity/live-check.ts"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "2.115.0",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "playwright": "1.63.0"
  }
}
