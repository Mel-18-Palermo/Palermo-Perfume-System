flowchart LR
    %% Palermo Perfume System — system-wide use-case overview
    %% This diagram intentionally groups detailed use cases into readable goal-oriented capabilities.

    Visitor["Visitor"]
    Customer["Customer"]
    Admin["Administrator"]

    Email["Email delivery service"]
    Stripe["Stripe sandbox / payment service"]
    AI["AI service / API"]

    subgraph Palermo["Palermo Perfume System"]
        direction TB

        subgraph Public["Public discovery, onboarding and shopping"]
            direction TB
            UC_REGISTER(["Register account"])
            UC_DISCOVER(["Browse, search and filter catalogue"])
            UC_VIRTUAL(["Explore virtual fragrance experience"])
            UC_COMPARE(["Compare perfumes"])
            UC_CUSTOMISE(["Customise eligible perfume items"])
            UC_LAYER_SAMPLE(["Get layering guidance / assemble sample set"])
            UC_QUIZ(["Complete fragrance discovery quiz"])
            UC_RECOMMEND(["Receive perfume recommendations"])
            UC_PUBLIC_SUPPORT(["Use public AI fragrance / policy support"])
            UC_CART(["Manage cart and promotional code"])
            UC_FEEDBACK(["Submit explicit AI/support feedback"])
        end

        subgraph Account["Customer account and profile"]
            direction TB
            UC_VERIFY(["Verify email and activate account"])
            UC_LOGIN(["Log in / reset password / log out"])
            UC_PROFILE(["Manage profile and addresses"])
            UC_PREFS(["Manage fragrance preferences"])
            UC_IDENTITY(["Generate Fragrance Identity"])
            UC_DEACTIVATE(["Deactivate account"])
            UC_WISHLIST(["Manage wishlist"])
        end

        subgraph Commerce["Authenticated commerce and fulfilment"]
            direction TB
            UC_CHECKOUT(["Select delivery method and place order"])
            UC_PAYMENT(["Process online payment"])
            UC_ORDER(["View order status and digital invoice"])
            UC_CANCEL(["Request eligible order cancellation"])
            UC_TRACK(["Track shipment and view delivery confirmation"])
            UC_PRIVATE_SUPPORT(["Use account-specific order / delivery AI support"])
        end

        subgraph Community["Customer participation"]
            direction TB
            UC_REVIEW(["Submit purchased-perfume review"])
            UC_LOYALTY(["Use loyalty points"])
            UC_SUBSCRIPTION(["Manage subscription opt-in / out"])
            UC_REFERRAL(["Use referral code / link"])
        end

        subgraph Administration["Authorised administration"]
            direction TB
            UC_CATALOGUE_ADMIN(["Manage products, variants, collections and fragrance classification"])
            UC_INVENTORY(["View inventory and manage finished-perfume production batches"])
            UC_PROMOTIONS(["Manage promotion codes and promotional content"])
            UC_AI_VIDEO(["Generate, preview and approve / reject AI promotional video"])
            UC_MODERATE(["Moderate customer reviews"])
            UC_REPORTS(["View dashboard and reports"])
            UC_ACCESS(["Manage admin accounts and RBAC"])
            UC_AUDIT(["View audit history"])
            UC_BACKUP(["Manage backup operations"])
        end

        UC_DELIVERY_SIM(["Simulate shipment tracking and delivery confirmation"])
    end

    %% Visitor associations
    Visitor --- UC_REGISTER
    Visitor --- UC_DISCOVER
    Visitor --- UC_VIRTUAL
    Visitor --- UC_COMPARE
    Visitor --- UC_CUSTOMISE
    Visitor --- UC_LAYER_SAMPLE
    Visitor --- UC_QUIZ
    Visitor --- UC_RECOMMEND
    Visitor --- UC_PUBLIC_SUPPORT
    Visitor --- UC_CART
    Visitor --- UC_FEEDBACK

    %% Customer associations
    Customer --- UC_DISCOVER
    Customer --- UC_VIRTUAL
    Customer --- UC_COMPARE
    Customer --- UC_CUSTOMISE
    Customer --- UC_LAYER_SAMPLE
    Customer --- UC_QUIZ
    Customer --- UC_RECOMMEND
    Customer --- UC_PUBLIC_SUPPORT
    Customer --- UC_CART
    Customer --- UC_FEEDBACK
    Customer --- UC_VERIFY
    Customer --- UC_LOGIN
    Customer --- UC_PROFILE
    Customer --- UC_PREFS
    Customer --- UC_IDENTITY
    Customer --- UC_DEACTIVATE
    Customer --- UC_WISHLIST
    Customer --- UC_CHECKOUT
    Customer --- UC_PAYMENT
    Customer --- UC_ORDER
    Customer --- UC_CANCEL
    Customer --- UC_TRACK
    Customer --- UC_PRIVATE_SUPPORT
    Customer --- UC_REVIEW
    Customer --- UC_LOYALTY
    Customer --- UC_SUBSCRIPTION
    Customer --- UC_REFERRAL

    %% Administrator associations
    Admin --- UC_CATALOGUE_ADMIN
    Admin --- UC_INVENTORY
    Admin --- UC_PROMOTIONS
    Admin --- UC_AI_VIDEO
    Admin --- UC_MODERATE
    Admin --- UC_REPORTS
    Admin --- UC_ACCESS
    Admin --- UC_AUDIT
    Admin --- UC_BACKUP

    %% External system interactions
    Email --- UC_VERIFY
    Email --- UC_LOGIN
    Stripe --- UC_PAYMENT
    AI --- UC_RECOMMEND
    AI --- UC_PUBLIC_SUPPORT
    AI --- UC_PRIVATE_SUPPORT
    AI --- UC_AI_VIDEO

    %% Internal delivery simulator is deliberately inside the Palermo boundary, not an actor.
    UC_TRACK -. internal workflow .-> UC_DELIVERY_SIM

    %% Important behavioural relationships
    UC_REGISTER -. initiates .-> UC_VERIFY
    UC_PREFS -. enables .-> UC_IDENTITY
    UC_CHECKOUT -. includes .-> UC_PAYMENT
    UC_PAYMENT -. success enables .-> UC_ORDER
    UC_ORDER -. exposes .-> UC_TRACK
