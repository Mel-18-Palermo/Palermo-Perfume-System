flowchart LR
    %% Palermo Perfume System — DFD Level 2
    %% Decomposition of Level 1 Process 4.0 using Gane & Sarson notation.

    Visitor@{ shape: rect, label: "Visitor" }
    Customer@{ shape: rect, label: "Customer" }
    Stripe@{ shape: rect, label: "Stripe sandbox / payment service" }

    subgraph Palermo["4.0 Cart, Order, Payment & Delivery"]
        direction TB

        P41@{ shape: rounded, label: "4.1 Manage Cart" }
        P42@{ shape: rounded, label: "4.2 Validate Checkout" }
        P43@{ shape: rounded, label: "4.3 Reserve Inventory & Create Order" }
        P44@{ shape: rounded, label: "4.4 Process & Verify Payment" }
        P45@{ shape: rounded, label: "4.5 Finalise Paid Order & Invoice" }
        P46@{ shape: rounded, label: "4.6 Manage Order & Cancellation" }
        P47@{ shape: rounded, label: "4.7 Manage Shipment & Tracking" }
        P48@{ shape: rounded, label: "4.8 Simulate Delivery Status" }

        D2@{ shape: datastore, label: "D2 Catalogue & Fragrance Data" }
        D3@{ shape: datastore, label: "D3 Commerce & Fulfilment Data" }
        D4@{ shape: datastore, label: "D4 Inventory & Production Data" }
        D7@{ shape: datastore, label: "D7 Admin, Promotion & Audit Data" }
    end

    %% 4.1 Manage Cart
    Visitor -->|"Variant/quantity/customisation and promo-code actions"| P41
    Customer -->|"Variant/quantity/customisation and promo-code actions"| P41
    P41 -->|"Validated temporary cart state and totals"| Visitor
    P41 -->|"Validated customer cart state and totals"| Customer
    P41 -->|"Variant, price and customisation eligibility query"| D2
    D2 -->|"Current authoritative variant/price/customisation data"| P41
    P41 -->|"Promotion eligibility query"| D7
    D7 -->|"Current promotion rule/status"| P41
    P41 -->|"Cart/cart-item updates"| D3
    D3 -->|"Current cart/cart-item state"| P41

    %% 4.2 Validate Checkout
    Customer -->|"Checkout confirmation, addresses and delivery selection"| P42
    P42 -->|"Changed-price/availability/promotion/delivery result or validated checkout"| Customer
    P42 -->|"Cart/order source-data query"| D3
    D3 -->|"Current cart and checkout state"| P42
    P42 -->|"Final variant/price/customisation validation query"| D2
    D2 -->|"Current authoritative sellable data"| P42
    P42 -->|"Final promotion validation query"| D7
    D7 -->|"Current promotion eligibility/status"| P42
    P42 -->|"Stock availability query"| D4
    D4 -->|"Available stock state"| P42
    P42 -->|"Validated checkout snapshot candidate"| P43

    %% 4.3 Reserve Inventory & Create Order
    P43 -->|"Atomic bounded reservation request"| D4
    D4 -->|"Reservation success/failure"| P43
    P43 -->|"Immutable order/item/address/delivery/discount snapshots and payment-attempt record"| D3
    D3 -->|"Order and payment reference"| P43
    P43 -->|"Order/payment reference for provider processing"| P44
    P43 -->|"Order placement failure if reservation cannot be obtained"| Customer

    %% 4.4 Process & Verify Payment
    P44 -->|"Payment initiation / server-side verification request"| Stripe
    Stripe -->|"Provider payment result and reference"| P44
    P44 -->|"Verified payment state/reference"| D3
    P44 -->|"Successful verified payment"| P45
    P44 -->|"Failed/expired payment release instruction"| D4
    P44 -->|"Payment failure/pending result"| Customer

    %% 4.5 Finalise Paid Order & Invoice
    P45 -->|"Commit reserved stock exactly once; record inventory movement"| D4
    D4 -->|"Commit result"| P45
    P45 -->|"Confirmed order state and digital invoice exactly once"| D3
    D3 -->|"Confirmed order/invoice record"| P45
    P45 -->|"Payment success, order confirmation and invoice availability"| Customer
    P45 -->|"Create one shipment workflow"| P47

    %% 4.6 Manage Order & Cancellation
    Customer -->|"Own-order/status/invoice lookup or cancellation request"| P46
    P46 -->|"Ownership/order-state lookup"| D3
    D3 -->|"Authoritative own-order/payment/invoice/fulfilment state"| P46
    P46 -->|"Recorded eligible cancellation request"| D3
    P46 -->|"Order status, invoice access, cancellation result"| Customer

    %% 4.7 Manage Shipment & Tracking
    Customer -->|"Own-shipment tracking request"| P47
    P47 -->|"Shipment/order lookup"| D3
    D3 -->|"Shipment/tracking record"| P47
    P47 -->|"Shipment creation/status-transition request"| P48
    P48 -->|"Tracking reference and controlled delivery status/confirmation"| P47
    P47 -->|"Updated shipment/tracking/delivery confirmation"| D3
    P47 -->|"Tracking status and delivery confirmation"| Customer

    %% 4.8 Internal delivery simulation
    P48 -->|"Current shipment-state lookup"| D3
    D3 -->|"Current eligible shipment state"| P48
    P48 -->|"Controlled simulated shipment-state update"| D3
