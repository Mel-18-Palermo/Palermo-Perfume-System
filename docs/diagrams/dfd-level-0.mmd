    %% Palermo Perfume System — Context Diagram / DFD Level 0
    %% Gane & Sarson notation:
    %% - external entities: rectangles
    %% - process: rounded rectangle
    %% - data flows: labelled arrows
    %% No internal data stores appear at Level 0.

    Visitor@{ shape: rect, label: "Visitor" }
    Customer@{ shape: rect, label: "Customer" }
    Admin@{ shape: rect, label: "Administrator" }

    Email@{ shape: rect, label: "Email delivery service" }
    Stripe@{ shape: rect, label: "Stripe sandbox / payment service" }
    AI@{ shape: rect, label: "AI service / API" }

    Palermo@{ shape: rounded, label: "0. Palermo Perfume System" }

    Visitor -->|"Registration details; catalogue/search/filter requests; temporary cart actions; quiz responses; public support enquiries; explicit feedback"| Palermo
    Palermo -->|"Registration/verification status; catalogue and virtual-fragrance information; cart totals; quiz/recommendation results; public support responses"| Visitor

    Customer -->|"Authentication data; profile/address/preferences; cart and checkout data; order/cancellation requests; delivery enquiries; reviews; loyalty/subscription/referral actions; support enquiries"| Palermo
    Palermo -->|"Account/profile information; catalogue/recommendations; validated cart/checkout results; order/payment status; invoice; tracking/delivery confirmation; loyalty/referral/support information"| Customer

    Admin -->|"Catalogue and classification changes; inventory/batch actions; promotion/content actions; review moderation; RBAC/admin changes; report/audit/backup requests"| Palermo
    Palermo -->|"Management confirmations; inventory/batch status; dashboard/report data; moderation status; audit history; backup status/metadata"| Admin

    Palermo -->|"Verification and password-reset message requests"| Email
    Email -->|"Delivery result/status"| Palermo

    Palermo -->|"Payment initiation/reference and server-side verification request"| Stripe
    Stripe -->|"Verified payment result and provider reference"| Palermo

    Palermo -->|"Minimised approved catalogue/profile/quiz/support/promotional context"| AI
    AI -->|"Recommendation/support/promotional-generation output"| Palermo
