# PostgreSQL URLs for the SAME isolated development/preview Supabase project.
# Use a dedicated database role owning only the private `palermo` schema.
# Application: transaction pooler (6543) or session pooler (5432).
DATABASE_URL=
# Prisma migrations: session pooler (5432) or an IPv6-reachable direct connection.
DIRECT_URL=
# Optional disposable test schema connection, always `schema=palermo_test`.
TEST_DATABASE_URL=
# Explicitly select development or preview for seed/test commands. Never use production data.
PALERMO_DATABASE_ENV=development
# URLs require sslmode=verify-full for Supabase and schema=palermo (tests: palermo_test).
# Public Supabase root CA; no private key is stored in the repository.
DATABASE_CA_FILE=prisma/certs/supabase-ca.crt
# The health/home scaffold still runs without database credentials.
