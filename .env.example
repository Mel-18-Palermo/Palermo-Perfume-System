# PostgreSQL URLs for the SAME isolated development/preview Supabase project.
# Use a dedicated database role owning only the private `palermo` schema.
# Application: transaction pooler (6543) or session pooler (5432).
DATABASE_URL=
# Prisma migrations: session pooler (5432) or an IPv6-reachable direct connection.
DIRECT_URL=
# Optional disposable test schema connection, always `schema=palermo_test`.
TEST_DATABASE_URL=
# Explicitly select development or preview for seed/test commands. Never use production data.
PALERMO_DATABASE_ENV=development
# Exact non-secret Supabase project ref explicitly permitted for destructive demo reset.
PALERMO_DEMO_SUPABASE_PROJECT_REF=
# URLs require sslmode=verify-full for Supabase and schema=palermo (tests: palermo_test).
# Public Supabase root CA; no private key is stored in the repository.
DATABASE_CA_FILE=prisma/certs/supabase-ca.crt
# The health/home scaffold still runs without database credentials.
# CI uses an ephemeral PostgreSQL service and no hosted service credentials.
# Vercel: assign isolated values to Preview only; configure Production separately.
# Never deploy TEST_DATABASE_URL or database-owner migration credentials to runtime.
# Vercel authentication belongs in the owner's local CLI credential store, not app env.

# Server-only Supabase Auth connection for this environment's isolated project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional owner-only provisioning/live test tooling. Normal auth routes do not use it.
SUPABASE_SERVICE_ROLE_KEY=
# Owner-supplied demo account secrets. Never commit values.
PALERMO_DEMO_CUSTOMER_PASSWORD=
PALERMO_DEMO_ADMIN_PASSWORD=
# Stripe test-mode only. Never expose the secret key to browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI recommendation provider — server only.
# Leave either value unset to use Palermo's deterministic recommendation fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
